# Copy to deploy/.env (git-ignored) and fill in. Never commit the real file.
MODEL_VERSION=v2              # v1 | v2 (A/B and rollback)
PRECISION=fp16
BATCH_PROFILE=1,2,4           # min,opt,max engine profile (measured in M3)
POSTGRES_PASSWORD=            # e.g. output of: openssl rand -hex 24
SECRET_KEY=                   # JWT signing key: openssl rand -hex 32
INGEST_KEY=                   # consumer -> backend shared secret: openssl rand -hex 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=               # first-start admin password (>= 10 chars)
RETENTION_DAYS=30
FRONTEND_BIND=127.0.0.1       # 0.0.0.0 publishes the dashboard on the LAN (decide consciously)
FRONTEND_PORT=8080
KAFKA_HEAP_OPTS="-Xms256m -Xmx384m"
LPR_INTERVAL=0
LPR_OSD=0
LPR_OUTPUT_RTSP=
LPR_MAX_CAMERAS=              # from docs/benchmark.md
CAM01_USER=
CAM01_PASS=
CAM02_USER=
CAM02_PASS=
SOURCES_FILE=./sources.yaml
MEDIA_DIR=../tests/data/private
