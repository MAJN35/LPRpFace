# Copy to deploy/.env (git-ignored) and fill in. Never commit the real file.
MODEL_VERSION=v3m             # v3m (YOLO12m, production since 2026-10-14) | v2 | v1 (A/B and rollback)
PRECISION=fp16
BATCH_PROFILE=1,2,2           # min,opt,max engine profile: must match a built engine (v3m: 1,2,2; v2: 1,2,4)
POSTGRES_PASSWORD=            # e.g. output of: openssl rand -hex 24
SECRET_KEY=                   # JWT signing key: openssl rand -hex 32
INGEST_KEY=                   # consumer -> backend shared secret: openssl rand -hex 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=               # first-start admin password (>= 10 chars)
RETENTION_DAYS=30
FRONTEND_BIND=0.0.0.0         # dashboard on the LAN (user decision 2026-10-13); the default admin must change its password first
FRONTEND_PORT=8080
KAFKA_HEAP_OPTS="-Xms256m -Xmx384m"
LPR_INTERVAL=0
LPR_LIVE=1                    # live view in the dashboard (raw camera + detection overlay)
LPR_MAX_CAMERAS=4             # measured memory-safe maximum for v2 at 960, mode 8 (docs/benchmark.md)
LPR_MAX_CAMERAS_AT_TARGET=0   # cameras reaching LPR_TARGET_FPS inferred fps (measured: none; 1 camera gets 3.5 fps)
LPR_TARGET_FPS=8
CAM01_USER=
CAM01_PASS=
CAM02_USER=
CAM02_PASS=
SOURCES_FILE=./sources.yaml
MEDIA_DIR=../tests/data/private

# Video emit policy: track timeout (s), minimum frames per track, emit implausible reads (0/1)
LPR_TRACK_TIMEOUT_S=3
LPR_MIN_TRACK_FRAMES=3
LPR_EMIT_INVALID=0
